{
  "name": "valintojen-toteuttaminen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=12 <13"
    }
  },
  "scripts": {
    "prepare": "husky",
    "dev": "react-router dev",
    "build": "react-router build",
    "build-test": "react-router build --mode test",
    "start-test": "pnpm run build-test && node --env-file=.env.test preview-server.mjs",
    "lint": "eslint --max-warnings=0",
    "lint:fix": "pnpm run lint -- --fix",
    "prettier": "prettier -u -c *",
    "prettier:fix": "prettier --write -u *",
    "test": "vitest",
    "test:debug": "DEBUG=vite-node:* vitest run",
    "test:coverage": "vitest run --coverage",
    "create-dev-certs": "mkdir -p certificates && cd certificates && mkcert localhost && mkcert -install",
    "create-self-signed-dev-certs": "mkdir -p certificates && openssl req -x509 -newkey rsa:4096 -keyout ./certificates/localhost-key.pem -out ./certificates/localhost.pem -sha256 -days 365 -nodes -subj \"/C=XX/ST=StateName/L=CityName/O=CompanyName/OU=CompanySectionName/CN=CommonNameOrHostname\"",
    "typecheck": "react-router typegen && tsc",
    "test-playwright-docker": "./scripts/run-playwright-tests-in-docker.sh",
    "start-and-test-playwright-docker": "START_SERVER_AND_TEST_INSECURE=1 start-server-and-test 'pnpm run start-test' https://localhost:3404 'pnpm run test-playwright-docker -- $PLAYWRIGHT_ARGS'",
    "node-extra-ca-certs": "export NODE_EXTRA_CA_CERTS=\"$(mkcert -CAROOT)/rootCA.pem\""
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@ebay/nice-modal-react": "^1.2.13",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "7",
    "@mui/material": "7",
    "@mui/system": "7",
    "@opetushallitus/oph-design-system": "^2.0.0",
    "@react-router/node": "^8.5.0",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-query-devtools": "^5.104.5",
    "@tolgee/format-icu": "^7.3.0",
    "@tolgee/react": "^7.3.0",
    "@xstate/react": "^6.1.0",
    "date-fns": "^4.4.0",
    "isbot": "^5.2.2",
    "nuqs": "^2.10.2",
    "quill": "^2.0.3",
    "react": "^19.3.1",
    "react-datepicker": "^9.1.0",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6",
    "react-router": "^8.5.0",
    "remeda": "^2.54.1",
    "xstate": "^5.33.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@axe-core/react": "^4.14.0",
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@react-router/dev": "^8.5.0",
    "@statelyai/inspect": "^0.7.2",
    "@tanstack/eslint-plugin-query": "^5.104.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/eslint-config-prettier": "^6.11.3",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/regexp.escape": "^2.0.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/eslint-plugin": "^1.6.28",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-playwright": "^2.12.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "http-proxy-middleware": "^4.2.1",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "regexp.escape": "^2.0.1",
    "sirv": "^3.0.0",
    "start-server-and-test": "^3.0.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
